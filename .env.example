# =============================================================================
# NEIOS (N-ATLAS Enterprise Integration OS) — active build env
# =============================================================================
# N-ATLAS provider — any OpenAI-compatible base URL.
#   vast.ai Ollama via SSH tunnel (CURRENT): http://127.0.0.1:18000/v1
#     ssh -N -L 18000:localhost:11434 -p <ssh-port> root@<ssh-host>
#     NOTE: local port must NOT be 11434 — a local Ollama already owns
#     127.0.0.1:11434 and will silently serve its own (wrong) model.
#   vast.ai vLLM via SSH tunnel (alt)      : http://127.0.0.1:8000/v1
#   HF Inference Endpoint                  : https://<name>.<region>.endpoints.huggingface.cloud/v1
NATLAS_BASE_URL=http://127.0.0.1:18000/v1
# Bearer token for the endpoint — Ollama ignores auth; set if using vLLM/HF.
NATLAS_API_KEY=devkey123
# Optional model id override; default = first id reported by GET /models.
# On the vast.ai Ollama instance this resolves to hf.co/QuantFactory/N-ATLaS-GGUF:Q4_K_M.
NATLAS_MODEL=
# Gated-model auth — only needed if serving the gated safetensors repo directly
# (vLLM path). Not required for the current ungated GGUF mirror.
HF_TOKEN=
# vast.ai account API key — used by the vastai CLI for instance lifecycle ops.
VAST_AI_API=
# Local audit/event store for the MVP.
DATABASE_URL=sqlite:./data/neios.db

# =============================================================================
# Future-extension layer ("VLTHR HR" — Workforce + ARWOS) example environment.
# Everything below this line belongs to the future layer, NOT the current NEIOS
# build. Copy to .env and fill locally. Never commit real values.
# Classification: all values below are PLACEHOLDERS.
# =============================================================================

# --- Core platform ---
DATABASE_URL=postgresql://vlthr:vlthr@localhost:5432/vlthr_hr
AUDIT_DATABASE_URL=postgresql://vlthr_audit:vlthr@localhost:5432/vlthr_audit
REDIS_URL=redis://localhost:6379/0

# --- Secrets manager (Infisical) ---
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev

# --- LLM gateway / models ---
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=
OPENAI_API_KEY=

# --- Agent runtime ---
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=
# Devin access model (A=BYO key / B=partner agreement / C=OpenAI-only) — unresolved, see engineering/questions/Q-0001
DEVIN_ACCESS_MODEL=TBD
DEVIN_SERVICE_USER_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Object storage (deliverables) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_DELIVERABLES=vlthr-deliverables
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Realtime ---
SOCKET_IO_PORT=3001

# --- Policy ---
OPA_URL=http://localhost:8181
